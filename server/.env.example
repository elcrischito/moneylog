# Copy to ".env" and adjust. Placeholders only — never commit a real .env.

# PostgreSQL connection string. SECRET in the cloud (Secret Manager).
DATABASE_URL="postgresql://moneylog:moneylog@localhost:5433/moneylog?schema=public"

# HTTP port of the API. The Vite dev server proxies /api to it.
PORT=4000

# Lifetime of a login session in hours (default 8).
# SESSION_TTL_HOURS=8

# Runtime mode; the cloud uses "production".
# NODE_ENV=development

# Seed passwords for the demo accounts. Required when NODE_ENV=production.
# Locally they fall back to the documented development password.
# SEED_ADMIN_PASSWORD=change-me
# SEED_USER_PASSWORD=change-me

# Allowed browser origins, comma-separated (optional, local development only).
# CORS_ORIGIN=http://localhost:5173

# Folder of the built React app served by the API in production (optional).
# CLIENT_DIST_DIR=../client/dist
